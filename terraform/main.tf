# ============================================================
# EVIDA CI/CD - AWS Infrastructure
# ============================================================
#
# This file creates the AWS resources required for our
# Jenkins-based CI/CD pipeline.
#
# Resources created:
#   1. S3 bucket       -> stores generated APK artifacts
#   2. Security Group  -> allows SSH and Jenkins web access
#   3. Jenkins EC2     -> hosts our Jenkins server
#
# The EC2 key pair is created separately in the AWS Console.
# Terraform only references the existing AWS key pair.
# ============================================================


# ------------------------------------------------------------
# AWS ACCOUNT INFORMATION
# ------------------------------------------------------------

# Retrieves the AWS account ID of the currently authenticated
# AWS CLI/Terraform user.
data "aws_caller_identity" "current" {}


# ------------------------------------------------------------
# DEFAULT VPC
# ------------------------------------------------------------

# Retrieves the default VPC in the current AWS region.
# We will launch our Jenkins EC2 inside this VPC.
data "aws_vpc" "default" {
  default = true
}


# ------------------------------------------------------------
# S3 BUCKET - CI/CD ARTIFACT STORAGE
# ------------------------------------------------------------

# This bucket will store artifacts generated by Jenkins,
# such as the Android APK.
resource "aws_s3_bucket" "evida_artifacts" {
  bucket = "evida-cicd-artifacts-2026"

  tags = {
    Name        = "EVIDA-CICD-Artifacts"
    Project     = "EVIDA"
    Environment = "CI-CD"
  }
}


# ------------------------------------------------------------
# SECURITY GROUP - JENKINS
# ------------------------------------------------------------

# Security group controls inbound and outbound traffic
# for the Jenkins EC2 instance.
resource "aws_security_group" "jenkins" {
  name        = "evida-jenkins-sg"
  description = "Security group for EVIDA Jenkins server"
  vpc_id      = data.aws_vpc.default.id

  # Jenkins web interface
  # We will access Jenkins using:
  # http://<EC2-PUBLIC-IP>:8080
  ingress {
    description = "Jenkins Web Interface"
    from_port   = 8080
    to_port     = 8080
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }

  # SSH access to the Jenkins EC2
  ingress {
    description = "SSH"
    from_port   = 22
    to_port     = 22
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }

  # Allow the Jenkins server to make outbound connections.
  # Jenkins needs internet access to download packages,
  # Git repositories, Gradle dependencies, etc.
  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }

  tags = {
    Name    = "EVIDA-Jenkins-SG"
    Project = "EVIDA"
  }
}


# ------------------------------------------------------------
# UBUNTU AMI
# ------------------------------------------------------------

# Find the latest Ubuntu 24.04 LTS AMI.
data "aws_ami" "ubuntu" {
  most_recent = true

  # Canonical's official AWS account ID
  owners = ["099720109477"]

  filter {
    name   = "name"
    values = ["ubuntu/images/hvm-ssd-gp3/ubuntu-noble-24.04-amd64-server-*"]
  }

  filter {
    name   = "virtualization-type"
    values = ["hvm"]
  }
}


# ------------------------------------------------------------
# JENKINS EC2 INSTANCE
# ------------------------------------------------------------

resource "aws_instance" "jenkins" {

  # Ubuntu 24.04 LTS
  ami = data.aws_ami.ubuntu.id

  # Free-tier eligible instance class where applicable
  # under the account's current free-tier/credit eligibility.
  instance_type = "c7i-flex.large"

  # Attach the Jenkins security group.
  vpc_security_group_ids = [
    aws_security_group.jenkins.id
  ]

  # IMPORTANT:
  # This must exactly match the key-pair name created
  # manually in the AWS EC2 Console.
  key_name = "evida-jenkins-key"

  tags = {
    Name        = "EVIDA-Jenkins"
    Project     = "EVIDA"
    Environment = "CI-CD"
  }
}